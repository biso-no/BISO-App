{
  "expo": {
    "name": "BISO",
    "slug": "BISO",
    "version": "0.9.31",
    "orientation": "portrait",
    "icon": "./assets/images/icon-notrans.png",
    "scheme": "biso",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "0.9.31",
      "bundleIdentifier": "com.biso.no"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "useNextNotificationsApi": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.biso.no",
      "versionCode": 22
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.biso.no",
          "enableGooglePay": true
        }
      ],
      "expo-localization",
      "expo-image-picker",
      [
        "./kotlin-version-plugin",
        "1.6.0"
      ],
      "expo-router",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "We only use this feature to collect anonymous data about how you use the app. This helps us improve the app and make it more useful for you. We do not collect any personal data, nor do we share any data with third parties."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4416309c-fcb7-4282-ad1a-2cad0300086f"
      }
    }
  }
}
